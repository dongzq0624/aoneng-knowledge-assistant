PORT=3001
# 使用智谱 GLM-4 在线模型
GLM_API_KEY=your_zhipu_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 可选模型: glm-4-flash (快速), glm-4.6 (更智能但较慢)
GLM_MODEL=glm-4.6
GLM_EMBEDDING_MODEL=embedding-3

# RAG 优化配置
# 是否使用快速模型进行预处理（关键词提取、查询改写）
# true: 使用 glm-4-flash 进行预处理，主模型生成最终回答（推荐用于 glm-4.6）
# false: 全程使用主模型
USE_FAST_PREPROCESSING=true
