PORT=3001

# 智谱 GLM 模型配置
GLM_API_KEY=your_zhipu_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 可选模型: glm-4-flash (快速), glm-4-plus (增强), glm-4v-flash (多模态)
GLM_MODEL=glm-4-flash
GLM_EMBEDDING_MODEL=embedding-3

# DeepSeek 模型配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 千问 Qwen 模型配置（阿里 DashScope）
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选模型: qwen-plus (推荐), qwen-max (旗舰), qwen-turbo (快速)
# 多模态: qwen-vl-plus (视觉增强), qwen-vl-max (视觉旗舰)
QWEN_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-plus
# 嵌入模型: qwen3-vl-embedding (多模态推荐), text-embedding-v4 (通用)
QWEN_EMBEDDING_MODEL=text-embedding-v4

# RAG 优化配置
# 是否使用快速模型进行预处理（关键词提取、查询改写）
USE_FAST_PREPROCESSING=true
